<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.score.claude-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__APP_DIR__/deploy/run.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.claude-bridge/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.claude-bridge/bridge.err.log</string>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
